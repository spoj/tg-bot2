# Required
TG_BOT_TOKEN=replace-me
DATA_DIR=/var/lib/tg-bot2

# Chat access is not configured here. The agent owns its allow list at
# DATA_DIR/workspace/.tg-bot/allowed.json; the first chat that ever messages
# the bot is added automatically, and the agent manages every later change.

# Pi provider files go under DATA_DIR/workspace/.pi/agent/.
