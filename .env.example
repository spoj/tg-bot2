# Required
TG_BOT_TOKEN=replace-me
ALLOWED_USER_IDS=123456789
DATA_DIR=/var/lib/minimal-tg-agent

# Pi provider credentials and model settings are stored per chat under
# DATA_DIR/chats/<chat-id>/workspace/.pi/agent/.

# systemd deployment backstop (aggregate resource limits):
# Edit the marked CPUQuota, MemoryMax, TasksMax, and TimeoutStopSec values in
# deploy/tg-bot2.service.example.