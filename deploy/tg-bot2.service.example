# Copy to /etc/systemd/system/tg-bot2.service after editing every EDIT REQUIRED value.
[Unit]
Description=tg-bot2 Telegram agent
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
# EDIT REQUIRED: create this unprivileged account, or replace both account values.
User=tg-bot2
Group=tg-bot2
# EDIT REQUIRED: absolute path to the checked-out/build deployment.
WorkingDirectory=/opt/tg-bot2
# Optional: override DATA_DIR if not using ~/.local/share/tg-bot2 (or provide via Environment).
# Environment="DATA_DIR=/var/lib/tg-bot2"
# EDIT REQUIRED: node binary and built entrypoint installed on this host.
ExecStart=/usr/bin/node /opt/tg-bot2/dist/src/index.js
Restart=on-failure
RestartSec=5s

# Stop all processes in this cgroup, including detached Bubblewrap children,
# within this short grace period.
KillMode=control-group
TimeoutStopSec=10s

# Aggregate limits for the application and all child Bubblewrap processes.
# EDIT REQUIRED: tune these values for the deployment.
CPUQuota=200%
MemoryMax=1G
TasksMax=256

[Install]
WantedBy=multi-user.target
