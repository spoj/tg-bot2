{
  "name": "tg-bot2",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --dir test",
    "test:integration": "RUN_BWRAP_TESTS=1 vitest run --dir test sandbox.test.ts pi-integration.test.ts",
    "check:layers": "node scripts/check-layer-boundaries.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.84.2",
    "grammy": "1.45.1"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "tsx": "4.23.11",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
