{
  "name": "tg-bot2",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --dir test",
    "test:integration": "RUN_BWRAP_TESTS=1 vitest run --dir test sandbox.test.ts pi-integration.test.ts",
    "lint": "eslint .",
    "check": "node scripts/ci.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.85.0",
    "@earendil-works/pi-coding-agent": "0.85.0",
    "@earendil-works/pi-server": "0.85.0",
    "grammy": "1.45.1",
    "typebox": "1.3.7",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "@types/ws": "^8.18.1",
    "eslint": "^10.8.1",
    "tsx": "4.23.11",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "4.1.10"
  }
}
